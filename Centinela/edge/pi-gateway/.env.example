# Copiar a .env (fuera de git) y completar.
# URL de la web de Centinela, vista desde la Pi (la IP de la laptop en la LAN).
CENTINELA_WEB_URL=http://192.168.1.10:3000
# Token que muestra una sola vez Centro de Dispositivos -> Vincular Raspberry Pi.
CENTINELA_GATEWAY_TOKEN=
# Broker Mosquitto (en la propia Pi).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Cola offline de eventos (SQLite).
COLA_DB=cola.db
# Visión (opcional, requirements-vision.txt). Vacío: sin visión, todo movimiento se disuade.
# Con modelo: solo se ahuyentan las clases de VISION_OBJETIVOS (nombres COCO en inglés) y nunca con una persona a la vista.
# En la Pi 5: yolo11n exportado a NCNN a 1280 px (~0.4 s por foto). Ver README "Visión".
VISION_MODELO=
VISION_OBJETIVOS=bird
VISION_CONFIANZA=0.5
