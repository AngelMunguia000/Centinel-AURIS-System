# Copia este archivo a .env.local y completa los valores. Ninguno de los
# valores de abajo es real — son placeholders.

# Base de datos (SQLite local — Prisma crea el archivo solo, no hace falta
# instalar nada)
DATABASE_URL="file:./prisma/dev.db"

# Firma el JWT propio de la app (lib/auth.ts), independiente del de Auth.js.
# Genera una cadena aleatoria fuerte, por ejemplo: openssl rand -base64 32
JWT_SECRET=""

# Google Generative AI (Gemini) — usada por AURIS Chat, app/api/chat-auris.
# Consíguela en https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# Auth.js (auth.ts) — solo hace el handshake OAuth con Google/GitHub, nunca
# autoriza nada por sí mismo (ver el comentario al inicio de auth.ts).
# AUTH_SECRET firma su sesión interna, distinta del JWT_SECRET de arriba.
# Genera uno con: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# OAuth Google — creado en console.cloud.google.com
# Redirect URI autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth GitHub — creado en github.com/settings/developers
# Callback URL autorizado: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Correo real (Resend) — solo necesario para recuperación de contraseña con
# envío real. Déjalas vacías en desarrollo: sin MAIL_PROVIDER el sistema no
# intenta enviar correo y el flujo de recuperación sigue funcionando (el
# candidato de correo real sigue documentado como pendiente en Brain/21).
RESEND_API_KEY=""
MAIL_PROVIDER=""
MAIL_FROM_ADDRESS=""
